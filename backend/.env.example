# =============================================================
# arXivisual Backend — Environment Variables
# =============================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# =============================================================

# ---------------------------
# LLM / AI
# ---------------------------
# Provider is auto-detected from which keys are set below.
# Set LLM_PROVIDER=azure or LLM_PROVIDER=dedalus to force one.
# LLM_PROVIDER=azure

# ---------------------------
# Azure OpenAI (GPT-5 family) — primary provider
# Billed against your Azure subscription (Microsoft for Startups credits apply).
# Create a resource + deployment in Azure AI Foundry, then fill these in.
# ---------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
# Deployment name you gave the model in Azure (defaults to gpt-5)
AZURE_OPENAI_DEPLOYMENT=gpt-5
# Reasoning depth: low | medium | high (default low = fast/cheap). Only these
# three work on both gpt-5-mini and gpt-6-luna; anything else warns and uses low.
# AZURE_OPENAI_REASONING_EFFORT=low
# Visual-QA judge + vision repair effort (same three values; default medium)
# VISUAL_QA_REASONING_EFFORT=medium

# ---------------------------
# Dedalus SDK + MCP Gateway — legacy fallback provider
# Sign up at https://www.dedaluslabs.ai/dashboard/api-keys to get your key.
# ---------------------------
# DEDALUS_API_KEY=dsk-your-dedalus-api-key

# ---------------------------
# Voiceover / TTS
# "openai" (default) routes narration through Azure OpenAI's OpenAI-compatible
#   endpoint at render time (reuses AZURE_OPENAI_* — no extra key needed).
# "gtts" is the free Google TTS fallback.
# ---------------------------
# VOICEOVER_TTS_SERVICE=openai
# VOICEOVER_VOICE_NAME=nova           # alloy | echo | fable | onyx | nova | shimmer
# VOICEOVER_TTS_MODEL=gpt-4o-mini-tts # must match an Azure TTS deployment name
# Override only if you have a real OpenAI key for TTS instead of Azure:
# OPENAI_API_KEY=sk-...

# ---------------------------
# Langfuse — LLM observability (traces, token usage, cost)
# Create a project at https://cloud.langfuse.com; both keys enable tracing.
# ---------------------------
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://us.cloud.langfuse.com   # US region; EU: https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=development       # set to "production" in prod to keep test traces separate

# ---------------------------
# Azure Application Insights — requests, dependencies, exceptions, logs
# (telemetry.py). Unset = off. Langfuse keeps its own OpenTelemetry tracer
# provider, so LLM traces are neither exported to App Insights nor sampled by it.
# ---------------------------
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=https://...
# OTEL_TRACES_SAMPLER=microsoft.fixed_percentage  # prod; without it the distro rate-limits (5 traces/s)
# OTEL_TRACES_SAMPLER_ARG=0.2                     # 20% of traces (traces PER SECOND if the line above is missing)
# OTEL_LOGS_EXPORTER=none                          # prod: console logs already reach Log Analytics; do not ship them twice

# ---------------------------
# PostHog — server-side product events (analytics.py). Unset = no events.
# paper_accepted (API) / paper_completed, paper_failed_server (worker).
# ---------------------------
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://us.i.posthog.com          # EU: https://eu.i.posthog.com

# ---------------------------
# Storage Mode
# ---------------------------
# "local" (default) — files stored in ./media/videos/
# "r2" — Cloudflare R2 cloud storage
STORAGE_MODE=local

# ---------------------------
# Cloudflare R2 (only needed when STORAGE_MODE=r2)
# ---------------------------
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=arxiviz-videos
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_URL=https://videos.arxiviz.org

# ---------------------------
# Modal.com
# Run `modal token new` to get your token.
# ---------------------------
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
RENDER_MODE=modal
# RENDER_TEST_EXECUTE=1                  # dry-run construct() gate before rendering (0 = import-only: same
#                                        # secret-scrubbed subprocess, construct() skipped — a weaker gate)

# ---------------------------
# Database
# ---------------------------
# Unset (default) = local SQLite file ./arxiviz.db.
# postgres:// and postgresql:// are rewritten to postgresql+asyncpg:// (which is
# also accepted as-is). With ENVIRONMENT=production a Postgres URL is REQUIRED:
# the app refuses to start on SQLite.
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?ssl=require

# ---------------------------
# Environment
# ---------------------------
# "production" disables POST /api/render unless RENDER_API_SECRET matches the
# X-Render-Secret header (the endpoint executes caller-supplied Python), drops
# localhost from the Turnstile hostname allow-list, requires DATABASE_URL, and
# turns SQL echo off. Anything else (default "development") is permissive.
# ENVIRONMENT=development
# RENDER_API_SECRET=                     # production only; unset = /api/render answers 404
# APP_COMMIT_SHA=                        # baked into the image by CI; shown as "commit" on /api/health and in the worker's startup log
# HEALTH_CACHE_TTL_SECONDS=20            # how long /api/health caches its database / R2 checks

# ---------------------------
# Temporal — durable orchestration (optional locally)
# Off (default) = the in-process BackgroundTasks pipeline (does not survive restarts).
# On: also run the worker — `uv run python -m temporal_app.worker` — and a
# Temporal server (`temporal server start-dev` listens on localhost:7233).
# ---------------------------
# USE_TEMPORAL=1
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TLS=0                          # 1 when Temporal sits behind TLS ingress (production: host:443)
# PIPELINE_CONCURRENCY=2                  # concurrent generations on the worker

# ---------------------------
# Visual QA — vision judge on rendered frames (extra LLM spend per video)
# ---------------------------
# ENABLE_VISUAL_QA=1                      # judge sampled frames for overlap / cut-off text
# VISUAL_QA_REPAIR=1                      # one vision-grounded repair + re-render for "major" defects (Temporal path only)
# VISUAL_QA_MODEL=gpt-5-mini
# VISUAL_QA_REPAIR_MODEL=                 # defaults to VISUAL_QA_MODEL
# VISUAL_QA_FRAMES=3
>>>>>>> fd95b28 (fix: import-only render gate runs in the scrubbed subprocess, not in-process)

# ---------------------------
# API Server
# ---------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- Admission control on POST /api/process (see backend/CLAUDE.md) ---
# DAILY_NEW_PAPER_CAP=80                  # durable per-UTC-day ceiling on new-paper jobs; 0 disables
# RATE_LIMIT_PROCESS_GLOBAL=6             # sliding-window global cap per window (prod: 6/h)
# RATE_LIMIT_PROCESS_PER_IP_DAILY=3
# TURNSTILE_SECRET_KEY=                   # Cloudflare Turnstile secret; unset = verification skipped
# TURNSTILE_ALLOWED_HOSTNAMES=arxivisual.org,www.arxivisual.org,localhost
# CORS_EXTRA_ORIGINS=                     # comma-separated extra browser origins (scheme://host[:port]) on top of arxivisual.org/www/localhost:3000
# IP_HASH_SECRET=                         # keys the pseudonymous client fingerprint in logs
