# Local Terraform working files
.terraform/
*.tfstate
*.tfstate.*

# Real variable values must never be committed (use terraform.tfvars.example
# as the template). The dependency lock file IS committed on purpose.
terraform.tfvars
*.auto.tfvars

# Local backend override used only for offline plan dry-runs
backend_override.tf
tfplan*

# Cut-over wizard artifacts (one-off runbook, local only). Plan files embed
# variable values, so they are secrets too.
*.tfplan
tf_env.sh
.cutover-wizard.env
cutover-wizard.sh
